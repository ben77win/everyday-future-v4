---
import '../styles/global.css';
---
<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8" />
<meta name="viewport" content="width=device-width, initial-scale=1" />
<title>Every Day Future</title>
<link rel="preconnect" href="https://fonts.googleapis.com" />
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
<link href="https://fonts.googleapis.com/css2?family=DM+Mono:wght@300;400&family=Inter:wght@200&display=swap" rel="stylesheet" />
</head>
<body ontouchstart="">

<slot />

<script>
  // ── Hero image rotation — cycles sequentially on each reload
  (function() {
    var bg = document.querySelector('.hero__bg');
    if (!bg) return;
    var images = [
      { src: '/images/rhododendron.jpg',  pos: '50% 60%' },
      { src: '/images/rainleaves.jpg',    pos: '50% 60%' },
      { src: '/images/silhouette-coast.jpg', pos: '50% 50%' },
      { src: '/images/rose-sky.jpg',         pos: '50% 40%' }
    ];
    var idx  = (parseInt(localStorage.getItem('edf_hero') || '0') + 1) % images.length;
    localStorage.setItem('edf_hero', idx);
    bg.style.backgroundImage    = 'url(' + images[idx].src + ')';
    bg.style.backgroundPosition = images[idx].pos;
  })();

  // ── Nav + floating CTA: toggle after hero exits
  var nav      = document.getElementById('nav');
  var hero     = document.getElementById('hero');
  var floatCta = document.getElementById('floatCta');

  if (hero && nav && floatCta) {
    new IntersectionObserver(function(entries) {
      var heroVisible = entries[0].isIntersecting;
      nav.classList.toggle('scrolled', !heroVisible);
      floatCta.classList.toggle('visible', !heroVisible);
    }, { threshold: 0.15 }).observe(hero);

    // ── Float CTA: inverted (white surface / ink label) while the hero is the
    //    section behind it; reverts to the default black once S2 scrolls behind it.
    var ctaLink = floatCta.querySelector('.float-cta__link');
    var updateCtaOverHero = function () {
      if (!ctaLink) return;
      var heroBottom = hero.getBoundingClientRect().bottom;
      var ctaTop = ctaLink.getBoundingClientRect().top;
      floatCta.classList.toggle('over-hero', heroBottom > ctaTop);
    };
    updateCtaOverHero();
    window.addEventListener('scroll', updateCtaOverHero, { passive: true });
    window.addEventListener('resize', updateCtaOverHero);
  }

  // ── Float CTA: invert colors when over the footer
  var siteFooter = document.querySelector('.site-footer');
  if (siteFooter && floatCta) {
    // Publish footer height so the CTA can park 10px above it (see .float-cta.over-footer).
    // ResizeObserver keeps it accurate through font loading, content/link changes, and wrapping.
    var setFooterH = function () {
      document.documentElement.style.setProperty('--footer-h', siteFooter.offsetHeight + 'px');
    };
    setFooterH();
    window.addEventListener('resize', setFooterH);
    if (window.ResizeObserver) {
      new ResizeObserver(setFooterH).observe(siteFooter);
    }
    new IntersectionObserver(function(entries) {
      floatCta.classList.toggle('over-footer', entries[0].isIntersecting);
    }, { threshold: 0 }).observe(siteFooter);
  }

  // ── S2 cards + S3 + other sections: staggered scroll reveal
  var revealEls = document.querySelectorAll('.s2__headline, .s2__card, .s3, .s4__body, .s4__tags, .s5__left, .s5__body, .s6__photos, .s6__bio, .s7__item');
  if (revealEls.length) {
    var rowObs = new IntersectionObserver(function(entries) {
      entries.forEach(function(entry) {
        if (entry.isIntersecting) {
          var el = entry.target;
          var delay = el.dataset.delay || 0;
          setTimeout(function() { el.classList.add('revealed'); }, delay);
          rowObs.unobserve(el);
        }
      });
    }, { threshold: 0.15 });

    revealEls.forEach(function(el, i) {
      el.dataset.delay = i * 110;
      rowObs.observe(el);
    });
  }

  // ── S3 carousel — infinite seamless loop (4s auto-advance + chevrons + drag).
  //    The track is tripled — [clones][originals][clones] — and scrollLeft is kept
  //    within the middle set's band; jumps land on identical content so it never
  //    visibly resets to card 1.
  (function () {
    var rail = document.getElementById('s3Rail');
    var prev = document.getElementById('s3Prev');
    var next = document.getElementById('s3Next');
    if (!rail) return;

    var originals = Array.prototype.slice.call(rail.querySelectorAll('.s3__card'));
    var n = originals.length;
    if (n < 2) return;

    // Clone a full set before AND after the originals so the loop works both ways.
    var before = document.createDocumentFragment();
    var after  = document.createDocumentFragment();
    originals.forEach(function (card) {
      var a = card.cloneNode(true); a.setAttribute('aria-hidden', 'true'); a.classList.add('s3__card--clone'); after.appendChild(a);
      var b = card.cloneNode(true); b.setAttribute('aria-hidden', 'true'); b.classList.add('s3__card--clone'); before.appendChild(b);
    });
    rail.appendChild(after);
    rail.insertBefore(before, rail.firstChild);

    var cardStep = 0, setWidth = 0;
    function measure() {
      var c = rail.querySelectorAll('.s3__card');
      cardStep = c[1].offsetLeft - c[0].offsetLeft;   // one card + gap
      setWidth = c[n].offsetLeft - c[0].offsetLeft;    // one full set (n cards)
    }
    measure();
    rail.scrollLeft = setWidth;   // start on the middle (original) set

    // Keep scrollLeft inside [setWidth, 2*setWidth): a ±setWidth jump lands on
    // identical content (the sets are clones), so it's invisible. Direct
    // scrollLeft assignment is instant (ignores scroll-behavior: smooth).
    function wrap() {
      if (setWidth <= 0) return;
      if (rail.scrollLeft >= 2 * setWidth) rail.scrollLeft -= setWidth;
      else if (rail.scrollLeft < setWidth) rail.scrollLeft += setWidth;
    }
    function step(dir) { if (!cardStep) return; wrap(); rail.scrollBy({ left: dir * cardStep, behavior: 'smooth' }); }

    // Wrap once a smooth scroll (auto-advance / chevron) settles; drag wraps live below.
    var dragging = false, settleTimer = null;
    rail.addEventListener('scroll', function () {
      if (dragging) return;
      clearTimeout(settleTimer);
      settleTimer = setTimeout(wrap, 120);
    });
    window.addEventListener('resize', function () { measure(); wrap(); });

    // Auto-advance every 4s, pause on hover/touch
    var paused = false;
    rail.addEventListener('pointerdown', function () { paused = true; });
    rail.addEventListener('mouseenter',  function () { paused = true; });
    rail.addEventListener('mouseleave',  function () { paused = false; });
    setInterval(function () { if (!paused) step(1); }, 4000);

    // Chevrons — no ends (infinite). Throttled so each advance completes + wraps
    // before the next (rapid mashing otherwise overlaps smooth scrolls and accumulates).
    var lastChev = 0;
    function chev(dir) { var t = Date.now(); if (t - lastChev < 550) return; lastChev = t; step(dir); }
    if (prev) prev.addEventListener('click', function () { chev(-1); });
    if (next) next.addEventListener('click', function () { chev(1); });

    // Mouse drag-to-scroll (incremental, so live wrapping stays seamless; touch is native)
    var lastX = 0;
    rail.addEventListener('pointerdown', function (e) {
      if (e.pointerType !== 'mouse') return;
      dragging = true; lastX = e.pageX;
      rail.classList.add('is-dragging');
      try { rail.setPointerCapture(e.pointerId); } catch (_) {}
    });
    rail.addEventListener('pointermove', function (e) {
      if (!dragging) return;
      rail.scrollLeft -= (e.pageX - lastX);
      lastX = e.pageX;
      wrap();
    });
    function endDrag() {
      if (!dragging) return;
      dragging = false;
      rail.classList.remove('is-dragging');
      if (cardStep) rail.scrollTo({ left: Math.round(rail.scrollLeft / cardStep) * cardStep, behavior: 'smooth' });
    }
    rail.addEventListener('pointerup', endDrag);
    rail.addEventListener('pointercancel', endDrag);
    rail.addEventListener('pointerleave', endDrag);
  })();

  // ── FAQ accordion
  document.querySelectorAll('.s7__trigger').forEach(function(btn) {
    btn.addEventListener('click', function() {
      var item = btn.closest('.s7__item');
      var isOpen = item.classList.contains('open');
      document.querySelectorAll('.s7__item.open').forEach(function(el) {
        el.classList.remove('open');
        el.querySelector('.s7__trigger').setAttribute('aria-expanded', 'false');
      });
      if (!isOpen) {
        item.classList.add('open');
        btn.setAttribute('aria-expanded', 'true');
      }
    });
  });

  // ── Taylor bio "show more"
  var bioToggle = document.getElementById('s6MoreToggle');
  if (bioToggle) {
    var bioEl = document.getElementById('s6Bio');
    bioToggle.addEventListener('click', function() {
      var open = bioEl.classList.toggle('more-open');
      bioToggle.setAttribute('aria-expanded', open ? 'true' : 'false');
      bioToggle.textContent = open ? 'Show less' : 'Show more';
    });
  }
</script>

</body>
</html>
