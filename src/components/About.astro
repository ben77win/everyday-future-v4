---
/* v5 — "Someday already started" per Figma V3 (Start frame 1447×552 @ top 3928).
   Scattered imagery + two body columns + blue clock scribble. All positions
   measured in the 1440 frame and converted to vw (÷14.4). The figure photo
   deliberately hangs below the text block, as in the comp. */
---
<section class="sd5" id="about">
  <img data-plx="-0.07" class="sd5__img sd5__img--pottery" src="/images/v5/someday-pottery.png" alt="" aria-hidden="true" />
  <img data-plx="0.08" class="sd5__img sd5__img--door" src="/images/waymaker-threshold.jpg" alt="" aria-hidden="true" />
  <video data-plx="-0.05" class="sd5__img sd5__img--figure sd5__video" src="/images/v5/someday-figure.mp4" poster="/images/v5/someday-figure-poster.jpg" autoplay muted loop playsinline preload="metadata" aria-hidden="true"></video>
  <img data-plx="-0.05" class="sd5__img sd5__img--figure sd5__video-still" src="/images/v5/someday-figure-poster.jpg" alt="" aria-hidden="true" />
  <img class="sd5__mark" src="/images/v5/scribble-clock.png" alt="" aria-hidden="true" />

  <h2 class="sd5__heading">Someday already started</h2>
  <p class="sd5__body sd5__body--a">Your future is created by your attention and actions every day, most visibly in work. Without practice, what's possible is limited by predictable patterns repeated unknowingly.</p>
  <p class="sd5__body sd5__body--b">Possibility is the capacity for change. With practice, what's possible expands through conscious change, reduced resistance, and meaningful progress toward the future you want, now.</p>
</section>

<style is:global>
.sd5 {
  position: relative;
  height: 53vw;
  background: var(--paper-off-b);
  overflow: hidden;
}
.sd5__img { position: absolute; object-fit: cover; }
.sd5__img--pottery { left: 0;       top: 9.00vw;  width: 16.76vw; height: 15.57vw; }
.sd5__img--door    { left: 79.54vw; top: 0;       width: 20.97vw; height: 23.47vw; opacity: 0.70; }
.sd5__img--figure  { left: 36.70vw; top: 35.56vw; width: 12.53vw; height: 15.46vw; }
/* figure slot: IMG_1357 video (Ben 2026-08-12; 0.5x + minterpolate, hero-water
   treatment) — no baked alpha on video, 70% via CSS over the solid ground */
.sd5__video, .sd5__video-still { opacity: 0.7; }
.sd5__video-still { display: none; }
@media (prefers-reduced-motion: reduce) {
  .sd5__video { display: none; }
  .sd5__video-still { display: block; }
}
.sd5__mark {
  position: absolute;
  /* Ben 2026-08-12: 20% smaller, pulled 15% into frame, then halved again
     (18.62 -> 9.31vw). Right edge held in place; top nudged to stay beside the
     body copy. Smaller render also lifts the low-res source density ~2x. */
  left: 92.34vw;
  top: 26.50vw;
  width: 9.31vw;
  pointer-events: none;
}
.sd5__heading {
  position: absolute;
  left: 2.08vw;
  top: 10.97vw;
  font-family: var(--font-display);
  font-weight: var(--fw-roman);
  font-size: 46px;
  letter-spacing: -0.020em;
  color: var(--ink);
}
.sd5__body {
  position: absolute;
  top: 28.06vw;
  width: 28.4vw;
  font-family: var(--font-body);
  font-weight: 300;
  font-size: 17px;
  line-height: 1.5;
  color: var(--ink);
}
.sd5__body--a { left: 2.08vw; }
.sd5__body--b { left: 55.76vw; }

@media (max-width: 900px) {
  /* Home Page - Mobile comp @360 frame (offsets from section top = band bottom):
     pottery at 2.8vw bleeding off the LEFT edge with the heading riding OVER it;
     body A; door image right (13.9vw inset); body B; figure indented 34.2vw. */
  /* flex + order gives the comp's reading order without touching the DOM (and so
     without changing desktop's absolute paint order) */
  .sd5 { position: relative; height: auto; padding: min(24.2vw, 91px) var(--gutter) min(40vw, 150px);  /* Ben 2026-08-10: comp's 61.7 here is an outlier (site of the duplicated-heading anomaly) — normalized to the big-break tier, matching Waymakers->Taylor */
         display: flex; flex-direction: column; align-items: stretch; }
  .sd5__heading   { order: 1; }
  .sd5__body--a   { order: 2; }
  .sd5__img--door { order: 3; }
  .sd5__body--b   { order: 4; }
  .sd5__img--figure { order: 5; }
  .sd5__heading,
  .sd5__body { position: static; width: auto; }
  .sd5__heading {
    position: relative;
    top: auto; left: auto;    /* clear the desktop absolute offsets */
    z-index: 1;               /* rides over the pottery, per comp */
    font-size: 7.8vw;         /* comp ~28pt — one line; 34px was wrapping */
    margin: 0 0 12.3vw;   /* trimmed 2.4vw: the live heading line box runs taller than the comp's cap height */
  }
  /* Figma (mobile frame, read from the file 2026-08-10): HN LT 45 Light,
     15px / 120% at the 360pt frame -> 4.17vw / 1.2 */
  .sd5__body { max-width: none; font-weight: 300; font-size: 4.17vw; line-height: 1.2; }
  .sd5__body--a { margin-bottom: 4.9vw; }
  .sd5__body--b { margin-bottom: 12.4vw; }
  .sd5__img { position: static; display: block; object-fit: cover; }
  /* ...but the poster still must stay hidden: the rule above has the same
     specificity as `.sd5__video-still { display: none }` and comes later, so it
     was un-hiding it and the water clip rendered twice on mobile (Ben 2026-08-12) */
  .sd5__video-still { display: none; }
  .sd5__img--pottery {
    position: absolute;
    top: 2.8vw;
    left: calc(-1 * var(--gutter));
    width: 36.7vw; height: 34.7vw;
    margin: 0;
    z-index: 0;
  }
  .sd5__img--door   { width: 32.2vw; height: 35.3vw; margin: 0 13.9vw 4.2vw auto; }
  .sd5__img--figure { width: 27.5vw; height: 34.2vw; margin: 0 0 0 34.2vw; }
  @media (prefers-reduced-motion: reduce) {
    .sd5__video { display: none; }
    .sd5__video-still { display: block; }
  }
  .sd5__mark { display: none; }
}
</style>
