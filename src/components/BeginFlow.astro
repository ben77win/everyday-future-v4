---
import Calendly from './Calendly.astro';
import { practiceOptions, optionByKey } from '../data/options';

const calendlyUrlsJson = JSON.stringify(
  Object.fromEntries(practiceOptions.map((o) => [o.key, o.calendlyUrl]))
);
const optionLabelsJson = JSON.stringify(
  Object.fromEntries(practiceOptions.map((o) => [o.key, o.label]))
);
const optionDeksJson = JSON.stringify(
  Object.fromEntries(practiceOptions.map((o) => [o.key, o.dek]))
);
---

<div id="bfData" data-labels={optionLabelsJson} data-urls={calendlyUrlsJson} data-deks={optionDeksJson} hidden></div>

<div class="begin-flow" id="beginFlow">

  <!-- ── STEP 1: Option selection ─────────────────────────────── -->
  <div class="bf-step" id="bfStep1">
    <div class="bf-step__inner">

      <div class="bf-nav">
        <a class="bf-back" href="/"><span class="bf-back__arrow" aria-hidden="true">←</span> Back</a>
        <span class="bf-nav__brand" aria-hidden="true"><img src="/images/wordmark-stacked.svg" alt="" /></span>
        <a class="bf-close" href="/" aria-label="Close and return to Every Day Future">×</a>
      </div>

      <div class="bf-steps" id="bfSteps1" aria-hidden="true"></div>

      <div class="bf-header">
        <h1 class="bf-headline">Choose how you want to practice.</h1>
      </div>

      <div class="bf-options" id="bfOptions" role="group" aria-label="Practice type">
        {practiceOptions.map((opt) => (
          <button
            class="bf-option"
            data-key={opt.key}
            type="button"
            aria-pressed="false"
          >
            <span class="bf-option__label">{opt.label}</span>
            <span class="bf-option__desc t-body-lg">{opt.desc}</span>
          </button>
        ))}
      </div>

    </div>
  </div>

  <!-- ── STEP 2: Contact form ──────────────────────────────────── -->
  <div class="bf-step bf-step--hidden" id="bfStep2">
    <div class="bf-step__inner bf-step2__inner">

      <!-- Top nav bar: ← CHANGE SELECTION ............ × (cancel to home) -->
      <div class="bf-nav">
        <button class="bf-back" id="bfBack" type="button">
          <span class="bf-back__arrow" aria-hidden="true">←</span> Back
        </button>
        <span class="bf-nav__brand" aria-hidden="true"><img src="/images/wordmark-stacked.svg" alt="" /></span>
        <a class="bf-close" href="/" aria-label="Cancel and return to Every Day Future">×</a>
      </div>

      <div class="bf-steps" id="bfSteps2" aria-hidden="true"></div>

      <!-- Anchored split: chip + service name + dek + offering detail LEFT,
           white form panel RIGHT (2026-06-11 Step 2 redesign, handoff 6) -->
      <div class="bf-step2-cols">

        <div class="bf-step2-left">
          <span class="bf-chip" id="bfChip">Selected · 1:1 Coaching</span>
          <h1 class="bf-step2-heading" id="bfStep2Heading">1:1 Coaching</h1>
          <p class="bf-step2-dek" id="bfStep2Dek">{optionByKey['1on1'].dek}</p>

          <div class="bf-step2-offerings">

          <!-- 1:1 -->
          <div class="bf-offering bf-offering--hidden" id="bfOffering1on1">
            <div class="bf-offering-card">
              <button class="bf-offering__toggle" type="button" aria-expanded="false">
                <span>What's included</span>
                <span class="bf-offering__toggle-icon" aria-hidden="true">+</span>
              </button>
              <div class="bf-offering-card__grid">
                <div class="bf-offering-card__section">
                  <span class="bf-offering-card__label">Structure</span>
                  <p class="bf-offering-card__body">Monthly subscription. 2x 60-minute virtual sessions. 3-month arcs.</p>
                </div>
                <div class="bf-offering-card__section">
                  <span class="bf-offering-card__label">What we practice</span>
                  <p class="bf-offering-card__body">Conscious change in how you work, relate, and create to reduce resistance, increase progress, and expand possibility.</p>
                </div>
                <div class="bf-offering-card__section">
                  <span class="bf-offering-card__label">Between sessions</span>
                  <p class="bf-offering-card__body">Suggested daily practice integrated with your work. Awareness building, practical exercises, intentional action, reflection and accountability.</p>
                </div>
                <div class="bf-offering-card__section">
                  <span class="bf-offering-card__label">AI-supported practice</span>
                  <p class="bf-offering-card__body">Optional. Session transcripts and pattern recognition support continuity across the arc.</p>
                </div>
              </div>
            </div>
          </div>

          <!-- Orgs & Teams -->
          <div class="bf-offering bf-offering--hidden" id="bfOfferingOrgs">
            <div class="bf-offering-card">
              <button class="bf-offering__toggle" type="button" aria-expanded="false">
                <span>What's included</span>
                <span class="bf-offering__toggle-icon" aria-hidden="true">+</span>
              </button>
              <div class="bf-offering-card__grid">
                <div class="bf-offering-card__section">
                  <span class="bf-offering-card__label">Structure</span>
                  <p class="bf-offering-card__body">Breadth and depth of engagement is designed by a coach to meet your leadership needs for the health of your organization. Virtual or in-person.</p>
                </div>
                <div class="bf-offering-card__section">
                  <span class="bf-offering-card__label">What we practice</span>
                  <p class="bf-offering-card__body">Conscious change in how individuals and teams work, relate, and create to reduce resistance, increase progress, and expand possibility.</p>
                </div>
                <div class="bf-offering-card__section">
                  <span class="bf-offering-card__label">Engagement types</span>
                  <p class="bf-offering-card__body">Co-founder coaching, leadership team and small cohort coaching, half or full day workshops, retreats and offsites.</p>
                </div>
                <div class="bf-offering-card__section">
                  <span class="bf-offering-card__label">Facilitation &amp; support</span>
                  <p class="bf-offering-card__body">Designed and facilitated by a trained, experienced, and certified coach. Practical frameworks, engaging participation, and useful skill-building.</p>
                </div>
              </div>
            </div>
          </div>

          <!-- Group -->
          <div class="bf-offering bf-offering--hidden" id="bfOfferingGroup">
            <div class="bf-offering-card">
              <button class="bf-offering__toggle" type="button" aria-expanded="false">
                <span>What's included</span>
                <span class="bf-offering__toggle-icon" aria-hidden="true">+</span>
              </button>
              <div class="bf-offering-card__grid">
                <div class="bf-offering-card__section">
                  <span class="bf-offering-card__label">Structure</span>
                  <p class="bf-offering-card__body">12-week guided group practice. Limited to 8 participants. 90-minute virtual sessions plus 3 individual coaching sessions.</p>
                </div>
                <div class="bf-offering-card__section">
                  <span class="bf-offering-card__label">What we practice</span>
                  <p class="bf-offering-card__body">Conscious change in how you work, relate, and create to reduce resistance, increase progress, and expand possibility.</p>
                </div>
                <div class="bf-offering-card__section">
                  <span class="bf-offering-card__label">Experience</span>
                  <p class="bf-offering-card__body">Community navigation of growth, change, and transition. Shared learning and supportive accountability.</p>
                </div>
                <div class="bf-offering-card__section">
                  <span class="bf-offering-card__label">Facilitation &amp; support</span>
                  <p class="bf-offering-card__body">Coach-led structure and facilitation. Practical frameworks, reflection, and AI-supported follow-ups.</p>
                </div>
              </div>
            </div>
          </div>

          <!-- Self-led -->
          <div class="bf-offering bf-offering--hidden" id="bfOfferingSelflead">
            <div class="bf-offering-card">
              <button class="bf-offering__toggle" type="button" aria-expanded="false">
                <span>What's included</span>
                <span class="bf-offering__toggle-icon" aria-hidden="true">+</span>
              </button>
              <div class="bf-offering-card__grid">
                <div class="bf-offering-card__section">
                  <span class="bf-offering-card__label">Structure</span>
                  <p class="bf-offering-card__body">Guided frameworks, exercises, reflections as a repeatable independent practice. Available Winter 2026.</p>
                </div>
                <div class="bf-offering-card__section">
                  <span class="bf-offering-card__label">What you practice</span>
                  <p class="bf-offering-card__body">Conscious change in how you work, relate, and create to reduce resistance, increase progress, and expand possibility.</p>
                </div>
              </div>
            </div>
          </div>

          </div><!-- /.bf-step2-offerings -->
        </div><!-- /.bf-step2-left -->

      <!-- Netlify Forms — hidden form for build-time detection -->
      <form name="begin" netlify netlify-honeypot="bot-field" hidden>
        <input type="text" name="first-name" />
        <input type="email" name="email" />
        <input type="tel" name="phone" />
        <input type="hidden" name="option" />
      </form>

      <!-- Right column: the anchored white form panel ("About you" + note + form).
           Top-aligned with the left column; stacks below the offering on mobile. -->
      <div class="bf-step2-formcol">
      <h2 class="bf-about-heading" id="bfAboutHeading">About you</h2>
      <p class="bf-form-note" id="bfFormNote">A few details about you to get connected with a coach. You'll be scheduled for a free discovery fit-check, not a sales call.</p>

      <form class="bf-form" id="bfForm" novalidate>
        <input type="hidden" name="form-name" value="begin" />
        <input type="hidden" name="option" id="bfOptionInput" />
        <p class="bf-honeypot" aria-hidden="true">
          <label>Don't fill this out: <input name="bot-field" tabindex="-1" autocomplete="off" /></label>
        </p>

        <div class="bf-field">
          <label class="bf-label" for="bfFirstName">First name</label>
          <input
            class="bf-input"
            id="bfFirstName"
            name="first-name"
            type="text"
            autocomplete="given-name"
            required
            placeholder="Your first name"
          />
          <span class="bf-field-error" id="bfFirstNameError">Please enter your first name</span>
        </div>

        <div class="bf-field">
          <label class="bf-label" for="bfEmail">Email</label>
          <input
            class="bf-input"
            id="bfEmail"
            name="email"
            type="email"
            autocomplete="email"
            required
            placeholder="you@example.com"
            inputmode="email"
          />
          <span class="bf-field-error" id="bfEmailError">Please enter a valid email address</span>
        </div>

        <div class="bf-field bf-field--phone">
          <label class="bf-label" for="bfPhone">
            Phone <span class="bf-optional">(optional)</span>
          </label>
          <input
            class="bf-input"
            id="bfPhone"
            name="phone"
            type="tel"
            autocomplete="tel"
            placeholder="+1 (206) 555-0100"
            inputmode="tel"
          />
        </div>

        <div class="bf-form-footer">
          <button class="bf-submit" id="bfSubmit" type="button">
            <span class="bf-submit__label" id="bfSubmitLabel">Continue to scheduling</span>
            <span class="bf-submit__label bf-submit__label--short" aria-hidden="true">Schedule</span>
            <svg class="bf-submit__arrow" id="bfSubmitArrow" width="22" height="11" viewBox="0 0 22 11" fill="none" stroke="currentColor" stroke-width="1.2" aria-hidden="true"><path d="M0 5.5h20M16 1l4 4.5-4 4.5" /></svg>
            <span class="bf-submit__spinner" aria-hidden="true"></span>
          </button>
          <span class="bf-field-error" id="bfSubmitError" role="alert">That didn't send — please try again.</span>
          <p class="bf-reassure" id="bfReassure">No obligation. Your details are never shared.</p>
        </div>
      </form>
      </div><!-- /.bf-step2-formcol -->

      </div><!-- /.bf-step2-cols -->
    </div>
  </div>

  <!-- ── STEP 3: Downstream ────────────────────────────────────── -->
  <div class="bf-step bf-step--hidden" id="bfStep3">
    <div class="bf-step__inner">

      <div class="bf-nav">
        <button class="bf-back" id="bfBack3" type="button">
          <span class="bf-back__arrow" aria-hidden="true">←</span> Back
        </button>
        <span class="bf-nav__brand" aria-hidden="true"><img src="/images/wordmark-stacked.svg" alt="" /></span>
        <a class="bf-close" href="/" aria-label="Close and return to Every Day Future">×</a>
      </div>

      <div class="bf-steps" id="bfSteps3" aria-hidden="true"></div>

      <!-- 3a: Calendly embed (shown for 1:1, group, orgs) — paper panel
           mirroring the Step-2 form panel so the surface reads continuous -->
      <div class="bf-calendly-wrap" id="bfCalendlyWrap">
        <div class="bf-header">
          <span class="bf-eyebrow" id="bfCalendlyEyebrow"></span>
          <h2 class="bf-headline">Book your call</h2>
          <p class="bf-subhead t-body-lg">Pick a time that works for you — Taylor will confirm shortly after.</p>
        </div>
        <div id="bfCalendlyMount"></div>
      </div>

      <!-- 3b: Self-led confirmation -->
      <div class="bf-selflead-wrap bf-step--hidden" id="bfSelfleadWrap">
        <div class="bf-selflead">
          <span class="bf-eyebrow">Self-led practice</span>
          <h2 class="bf-headline bf-selflead__headline">You're on the list.</h2>
          <p class="bf-selflead__body t-body-lg">
            Thank you for your interest. Our self-led practice will be available
            <strong>Winter 2026</strong> — we'll be in touch with everything you
            need to begin.
          </p>
          <a href="/" class="bf-selflead__home t-cta">Return to Every Day Future</a>
        </div>
      </div>

    </div>
  </div>

</div>

<style>
/* ── Flow container */
.begin-flow {
  width: 100%;
  min-height: calc(100vh - 80px);
  display: flex;
  flex-direction: column;
}

/* ── Steps */
.bf-step {
  flex: 1;
  display: flex;
  flex-direction: column;
  animation: bfFadeIn 0.45s cubic-bezier(0.16, 1, 0.3, 1) both;
}
.bf-step--hidden {
  display: none !important;
}

@keyframes bfFadeIn {
  from { opacity: 0; transform: translateY(18px); }
  to   { opacity: 1; transform: translateY(0); }
}

.bf-step__inner {
  position: relative;
  width: 100%;
  max-width: 680px;
  margin: 0 auto;
  padding: 72px var(--gutter) 80px;
  flex: 1;
  display: flex;
  flex-direction: column;
}

/* ── Header block (Step 1 / Step 3) */
.bf-header {
  margin-bottom: 36px;
}

.bf-eyebrow {
  display: block;
  font-family: var(--font-mono);
  font-size: 13px;
  letter-spacing: 0.110em;
  text-transform: uppercase;
  color: rgba(0,0,0,0.40);
  margin-bottom: 18px;
}

/* Step 1 headline / Step 3 headline */
.bf-headline {
  font-family: var(--font-body);
  font-weight: 400;
  font-size: clamp(46px, 5.2vw, 80px);
  letter-spacing: -0.030em;
  line-height: 1.0;
  color: var(--ink);
}

.bf-subhead {
  margin-top: 14px;
  color: rgba(0,0,0,0.50);
}

/* Step 1 inner is full-width so cards span page */
#bfStep1 .bf-step__inner {
  max-width: var(--max-w);
}

/* ── Step 2 inner — wider to accommodate 2-col */
/* v5: step 2 is a full-bleed viewport split — no max-width cap (the old
   handoff-6 1280px !important cap made the cream panel float inset on wide
   screens; this is what broke the "Group 41" match on Ben's display). */
.bf-step2__inner {
  max-width: none !important;
}

/* ── Step 2 nav bar */
/* Consistent nav row on every step: ← Back (left) · brand (center) · × (right) */
.bf-nav {
  display: grid;
  grid-template-columns: 1fr auto 1fr;
  align-items: center;
  padding-bottom: 18px;
  margin-bottom: 18px;   /* the step indicator sits directly under the nav */
  border-bottom: 0.5px solid rgba(0,0,0,0.12);
}

/* ── Step indicator — quiet DM Mono progress row on every step (2026-06-11).
   Booking: Choose → Your details → Schedule · Self-led: Choose → Join the list.
   Items rendered by JS (renderSteps) so the count/labels follow the option.
   Mono 13px (site floor — normalized from the comp's 12) + 1px lines (site hairline). */
.bf-steps {
  display: flex;
  align-items: center;
  margin-bottom: 48px;
}
/* Items are injected by JS (renderSteps) — they carry no Astro scope attribute,
   so style them via :global under the scoped .bf-steps container. */
.bf-steps :global(.bf-step-item) {
  display: flex;
  align-items: center;
  gap: 12px;
  font-family: var(--font-mono);
  font-size: 13px;
  letter-spacing: 0.110em;
  text-transform: uppercase;
  color: rgba(0,0,0,0.35);
  white-space: nowrap;
}
.bf-steps :global(.bf-step-item__num) {
  width: 22px;
  height: 22px;
  border: 1px solid rgba(0,0,0,0.25);
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 12px;
  flex: 0 0 auto;
}
.bf-steps :global(.bf-step-item--done) { color: rgba(0,0,0,0.55); }
.bf-steps :global(.bf-step-item--done .bf-step-item__num) { border-color: rgba(0,0,0,0.4); }
.bf-steps :global(.bf-step-item--on) { color: var(--ink); }
.bf-steps :global(.bf-step-item--on .bf-step-item__num) {
  background: var(--blue);
  border-color: var(--blue);
  color: #fff;
}
.bf-steps :global(.bf-step-line) {
  width: 48px;
  height: 1px;
  background: rgba(0,0,0,0.2);
  margin: 0 18px;
  flex: 0 0 auto;
}
/* v5: on the step-2 split screen the indicator pins to the cream panel's
   bottom-left (comp: ✓ CHOOSE — ② YOUR DETAILS — ③ SCHEDULE at x46, bottom 34) */
#bfSteps2 {
  position: absolute;
  left: 46px;
  bottom: 34px;
  z-index: 2;
  margin: 0;
}
@media (max-width: 900px) {
  #bfSteps2 { position: static; margin: 0 0 24px; }
  #bfStep2 .bf-step__inner .bf-nav { display: grid; position: static; padding: 20px var(--gutter) 0; background: none; }
  #bfStep2 .bf-step__inner { padding-top: 0; }
  .bf-step2-left { padding-top: 32px; }
  .bf-step2-heading { margin-top: 0; }
  .bf-step2-formcol > * { max-width: none; }
}
/* Explicit columns so the × stays hard-right even when the wordmark is hidden
   (display:none removes it from grid auto-placement, which otherwise pushed × to the middle column) */
.bf-nav .bf-back  { grid-column: 1; justify-self: start; }
.bf-nav .bf-close { grid-column: 3; justify-self: end; margin-left: 0; }
/* Wordmark — shown only in the drawer (the standalone page already has the site nav) */
/* v5: the stacked SVG wordmark (was the v4 single-line text lockup, HN 200 22px)
   — the mark is now one artwork everywhere (Ben 2026-08-13) */
.bf-nav__brand {
  display: none;
  grid-column: 2;
  justify-self: center;
  line-height: 0;
}
.bf-nav__brand img { width: 92px; height: auto; } /* matches the mobile-menu top-bar mark */
:global(.begin-page--drawer) .bf-nav__brand { display: block; }
/* In the homepage drawer (full-screen, no tappable scrim) keep the nav pinned so
   Back/× stay reachable while scrolling — this replaces the old fixed drawer bar. */
:global(.begin-page--drawer) .bf-nav {
  position: sticky;
  top: 0;
  z-index: 10;
  background: var(--paper-cream);
}

/* Cancel / close → main site */
.bf-close {
  margin-left: auto;
  display: inline-flex;
  align-items: center;
  justify-content: center;
  width: 32px;
  height: 32px;
  font-family: var(--font-body);
  font-size: 30px;
  line-height: 1;
  color: rgba(0,0,0,0.40);
  text-decoration: none;
  transition: color 0.2s ease;
}
.bf-close:hover { color: var(--blue); }


/* ── Step 2 — v5 split screen (2026-08-05, Figma V3 "On About you section
   click", flat variant per Ben): LEFT half = full-bleed CREAM #FFFCD1 panel
   (chip / service H1 / dek / hairline / 2×2 offering grid / step indicator
   pinned bottom-left); RIGHT half = white with the About-you form column. */
.bf-step2-cols {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 0;
  align-items: stretch;
}
#bfStep2 { position: relative; background: var(--paper); }
#bfStep2 .bf-step__inner { max-width: none; padding: 0; }
/* v5 desktop (1440w light comp): no back/× row — the site nav is the chrome.
   The row stays in the homepage drawer (needs its own close) and on mobile. */
#bfStep2 .bf-nav { display: none; }
:global(.begin-page--drawer) #bfStep2 .bf-nav {
  display: grid;
  position: sticky;
  top: 0;
  z-index: 3;
  padding: 22px 46px;
  margin: 0;
  border: none;
  background: var(--paper);
}
.bf-step2-left {
  background: #FFFCD1; /* v5 Begin cream — deliberate callback to the v4 ground */
  padding: 150px 60px 140px 36px;
  min-height: 100vh; /* cream persists to the viewport bottom (page has no top offset anymore) */
}
/* top = left panel's 150 + chip 28 + chip margin 28 + 56 gap, so "About you"
   top-aligns with the service-name H1 (per Ben / 1440w light comp) */
.bf-step2-formcol { padding: 262px 60px 96px 140px; }

/* Selected chip — blue boxed mono per comp */
.bf-chip {
  display: inline-flex;
  align-items: center;
  height: 28px;
  padding: 0 14px;
  border: 1px solid var(--blue);
  border-radius: 2px;
  font-family: var(--font-mono);
  font-size: 13px;
  letter-spacing: 0.110em;
  text-transform: uppercase;
  color: var(--blue);
  margin-bottom: 28px;
}
.bf-chip--soon {
  border-color: var(--blue);
  color: var(--blue);
}

/* Service name — the single H1 (1440w light comp: ~96px) */
.bf-step2-heading {
  font-family: var(--font-body);
  font-weight: 400;
  font-size: clamp(46px, 6.7vw, 96px);
  letter-spacing: -0.030em;
  line-height: 0.98;
  color: var(--ink);
  margin-top: 56px; /* chip → heading gap per comp */
}

/* Dek — one supporting line under the name (the approved offering title copy) */
.bf-step2-dek {
  font-family: var(--font-body);
  font-weight: 400;
  font-size: clamp(20px, 2vw, 26px);
  line-height: 1.25;
  letter-spacing: -0.010em;
  color: var(--ink);
  margin-top: 24px;
  max-width: 520px;
}

/* ── Offering detail — on the cream under a top hairline */
.bf-step2-offerings { margin-top: 48px; }

.bf-offering {
  padding-top: 36px;
  border-top: 1px solid rgba(0,0,0,0.18);
}

.bf-offering-card {
  background: transparent;
  padding: 0;
}

/* "What's included" toggle — mobile only (desktop always shows the grid) */
.bf-offering__toggle { display: none; }

.bf-offering-card__grid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 36px 48px;
}

/* 1440w light comp: sentence-case body labels, not mono caps */
.bf-offering-card__label {
  display: block;
  font-family: var(--font-body);
  font-weight: 400;
  font-size: 17px;
  letter-spacing: -0.005em;
  color: var(--ink);
  margin-bottom: 10px;
}

.bf-offering-card__body {
  font-family: var(--font-body);
  font-weight: 300;
  font-size: 16px;
  line-height: 24px;
  letter-spacing: 0.020em;
  color: rgba(0,0,0,0.66);
}

/* ── Form column (right) — v5: the whole right half is white; the form is a
   ~300px column (comp: fields x 875–1143 @1440). Padding set in the split
   block above. */
.bf-step2-formcol {
  background: var(--paper);
  align-self: stretch;
  max-width: none;
}
.bf-step2-formcol > * { max-width: 508px; } /* 1440w light comp: form column ~490–510 */

.bf-about-heading {
  font-family: var(--font-body);
  font-weight: 400;
  font-size: clamp(38px, 5.9vw, 85px);  /* 1440w light comp "About you" */
  line-height: 1.0;
  letter-spacing: -0.030em;
  color: var(--ink);
  margin-top: 0;
  padding-bottom: 0;
  border-bottom: none;
  margin-bottom: 30px;
}

/* ── Step 1 option grid — 4-up matching S2 cards */
.bf-options {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: 4px;
}

.bf-option {
  position: relative;
  display: flex;
  flex-direction: column;
  gap: 12px;
  padding: 28px 24px 32px;
  background: var(--card-yellow-b); /* v5: yellow cards matching homepage Choose How */
  border: none;
  cursor: pointer;
  text-align: left;
  transition: background 0.22s ease, color 0.22s ease, filter 0.2s ease;
  aspect-ratio: 1 / 1;
}
.bf-option[data-key="1on1"] { background: var(--card-yellow-a); }

.bf-option__label {
  font-family: var(--font-body);
  font-weight: 400;
  font-size: 32px;
  letter-spacing: -0.020em;
  line-height: 1.05;
  color: var(--ink);
  transition: color 0.22s ease;
}

.bf-option__desc {
  margin-top: auto;   /* anchor to bottom of the card, matching S2 */
  color: rgba(0,0,0,0.55);
  transition: color 0.22s ease;
}

/* Hover: slight darken (matches homepage Choose How cards); selected inverts blue */
.bf-option:hover { filter: brightness(0.97); }

.bf-option[aria-pressed="true"] { background: var(--blue); }
.bf-option[aria-pressed="true"] .bf-option__label { color: var(--paper); }
.bf-option[aria-pressed="true"] .bf-option__desc  { color: rgba(255,255,255,0.62); }

/* ── Back button */
.bf-back {
  display: inline-flex;
  align-items: center;
  gap: 8px;
  background: none;
  border: none;
  cursor: pointer;
  padding: 0;
  color: rgba(0,0,0,0.35);
  font-family: var(--font-mono);
  font-size: 13px;
  letter-spacing: 0.110em;
  text-transform: uppercase;
  transition: color 0.2s ease;
}
.bf-back:hover { color: var(--blue); }
.bf-back__arrow { font-size: 14px; }

/* ── Offering block visibility */
.bf-offering--hidden { display: none; }

/* ── Form */
.bf-form {
  display: flex;
  flex-direction: column;
  gap: 0;
}

.bf-honeypot {
  position: absolute;
  left: -9999px;
  opacity: 0;
  pointer-events: none;
}

.bf-field {
  display: flex;
  flex-direction: column;
  position: relative; /* containing block for the sr-only labels */
  padding: 30px 0 26px;  /* 1440w light comp: airier field rhythm */
  border-bottom: 0.5px solid rgba(0,0,0,0.22);
  transition: border-color 0.2s ease;
}
/* (No border-top on the first field — the "About you" hairline + note sit above.) */

/* Hide the optional phone field in the Self-led waitlist variant */
.bf-form--waitlist .bf-field--phone { display: none; }
/* Focus / error feedback now lives on the single field divider */
.bf-field:focus-within { border-bottom-color: var(--blue); }
.bf-field:has(.bf-input--error) { border-bottom-color: var(--ink); }

/* v5 (1440w light): no visible mono labels — placeholder-style fields only.
   Labels stay in the DOM for screen readers / validation targeting. */
.bf-label {
  position: absolute;
  width: 1px; height: 1px;
  overflow: hidden;
  clip: rect(0 0 0 0);
  white-space: nowrap;
}

.bf-optional {
  font-family: var(--font-mono);
  font-size: 13px;
  letter-spacing: 0.110em;
  text-transform: uppercase;
  color: rgba(0,0,0,0.28);
}

.bf-input {
  background: transparent;
  border: none;
  outline: none;
  font-family: var(--font-body);
  font-weight: 300;
  font-size: 16px;
  letter-spacing: 0.020em;
  color: var(--ink);
  padding: 8px 0 10px;
  width: 100%;
  -webkit-appearance: none;
  border-radius: 0;
}
.bf-input::placeholder { color: rgba(0,0,0,0.60); } /* 1440w light: placeholder doubles as the field label */

.bf-field-error {
  display: none;
  font-family: var(--font-mono);
  font-size: 13px;
  letter-spacing: 0.110em;
  text-transform: uppercase;
  color: var(--ink);
  opacity: 0.55;
  margin-top: 8px;
}
.bf-field-error.visible { display: block; }

/* ── Form footer */
.bf-form-footer {
  margin-top: 32px;
  display: flex;
  flex-direction: column;
  align-items: stretch;
  gap: 16px;
}

/* ── Submit button — full panel width, names the next step */
.bf-submit {
  position: relative;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 12px;
  width: 100%;
  min-height: 52px;
  padding: 12px 24px;
  background: var(--ink);
  color: var(--paper);
  border: none;
  border-radius: 0; /* v5: squared per comp */
  margin-top: 40px; /* last field → button gap per comp */
  cursor: pointer;
  transition: background 0.25s ease;
}
.bf-submit:hover { background: var(--blue); }
.bf-submit:disabled { opacity: 0.50; cursor: default; background: var(--ink); }

.bf-submit__label {
  font-family: var(--font-mono);
  font-size: 14.4px;
  letter-spacing: 0.110em;
  text-transform: uppercase;
  transition: opacity 0.2s;
}
.bf-submit.loading .bf-submit__label { opacity: 0; }

/* Short booking label ("Schedule →") — swapped in ≤900 where the panel is
   narrow (see the tablet media block); waitlist keeps "Notify me" everywhere. */
.bf-submit__label--short { display: none; }

.bf-submit__arrow {
  flex: 0 0 auto;
  transition: opacity 0.2s;
}
.bf-submit.loading .bf-submit__arrow { opacity: 0; }
.bf-form--waitlist .bf-submit__arrow { display: none; }

/* Reassurance line under the submit */
.bf-reassure {
  font-family: var(--font-body);
  font-weight: 300;
  font-size: 12.5px;
  line-height: 1.5;
  color: rgba(0,0,0,0.45);
  text-align: center;
  margin: 0;
}

.bf-submit__spinner {
  display: none;
  position: absolute;
  width: 18px;
  height: 18px;
  border: 1.5px solid rgba(255,255,255,0.3);
  border-top-color: #fff;
  border-radius: 50%;
  animation: bfSpin 0.7s linear infinite;
}
.bf-submit.loading .bf-submit__spinner { display: block; }

@keyframes bfSpin {
  to { transform: rotate(360deg); }
}

/* Context note under the "About you" heading */
.bf-form-note {
  font-family: var(--font-body);
  font-weight: 300;
  font-size: 14px;
  line-height: 1.5;
  letter-spacing: 0.020em;
  color: rgba(0,0,0,0.55);
  margin-bottom: 8px;
}

/* ── Step 3: Calendly — paper panel mirroring the Step-2 form panel geometry */
.bf-calendly-wrap {
  background: var(--paper);
  padding: 48px 44px 44px;
}
.bf-calendly-wrap .bf-header {
  margin-bottom: 36px;
}

#bfCalendlyMount {
  margin: 0;
}

/* ── Step 3: Self-led */
.bf-selflead {
  display: flex;
  flex-direction: column;
  align-items: flex-start;
}

.bf-selflead__headline {
  margin-top: 8px;
  margin-bottom: 24px;
}

.bf-selflead__body {
  color: rgba(0,0,0,0.60);
  max-width: 460px;
  margin-bottom: 44px;
}
.bf-selflead__body strong {
  color: var(--ink);
  font-weight: 400;
}

.bf-selflead__home {
  display: inline-flex;
  align-items: center;
  gap: 8px;
  font-family: var(--font-mono);
  font-size: 13px;
  letter-spacing: 0.110em;
  text-transform: uppercase;
  color: rgba(0,0,0,0.40);
  text-decoration: none;
  border-bottom: 0.5px solid transparent;
  padding-bottom: 2px;
  transition: color 0.2s, border-color 0.2s;
}
.bf-selflead__home:hover {
  color: var(--blue);
  border-bottom-color: rgba(41,86,224,0.40);
}

/* ── Tablet ≤ 900px */
@media (max-width: 900px) {
  .bf-options { grid-template-columns: repeat(2, 1fr); }
  #bfStep1 .bf-step__inner { max-width: 100%; }

  /* Step 2 keeps the 2-col anchored split down to 640 (per Ben 2026-06-11);
     the narrow panel gets the short booking label instead (see
     .bf-submit__label--short) so the submit never wraps to 3 lines. */
  .bf-form:not(.bf-form--waitlist) .bf-submit__label { display: none; }
  .bf-form:not(.bf-form--waitlist) .bf-submit__label--short { display: inline; }
}

/* ── Mobile ≤ 640px */
@media (max-width: 640px) {

  /* Step 1 */
  #bfStep1 { flex: none; }
  #bfStep1 .bf-step__inner {
    padding-top: 20px;
    padding-bottom: 40px;
    min-height: 0;
  }
  #bfStep1 .bf-header { margin-bottom: 24px; }  /* matches the 24px above the heading (.bf-nav margin-bottom) — symmetric */

  /* Step 1 cards: 1-up, fixed 140px so all four + heading fit one mobile viewport (no scroll) */
  .bf-options { grid-template-columns: 1fr; gap: 8px; }
  .bf-option { aspect-ratio: auto; height: 140px; padding: 20px 28px; }
  .bf-option__label { font-size: 25px; }

  /* Steps 2 & 3 — 44px mobile top: echoes the section rhythm without doubling up
     under the fixed nav (72px felt too airy). Step 1 stays tight for the one-viewport fit. */
  #bfStep2 .bf-step__inner { padding-top: 44px; padding-bottom: 40px; }
  #bfStep3 .bf-step__inner { padding-top: 44px; }

  /* All in-flow headlines (Step 1 "Choose…", Step 2 service name, Step 3 "Book your call")
     match on mobile at the Sub-display tier — the flow is a distinct, smaller-headline state. */
  .bf-headline,
  .bf-step2-heading { font-size: clamp(22px, 2.2vw, 32px); letter-spacing: -0.010em; line-height: 1.2; }

  /* Step 2 nav */
  .bf-nav { margin-bottom: 14px; padding-bottom: 14px; }

  /* Step indicator: connectors shrink; only the CURRENT step keeps its label
     (the spec'd all-labels row measures ~420px at 13px mono — wider than the
     viewport at 375px, so the off steps collapse to their numbered circles) */
  .bf-steps { margin-bottom: 28px; }
  .bf-steps :global(.bf-step-line) { width: 24px; margin: 0 12px; }
  .bf-steps :global(.bf-step-item) { font-size: 0; gap: 0; }
  .bf-steps :global(.bf-step-item__num) { font-size: 12px; }
  .bf-steps :global(.bf-step-item--on) { font-size: 13px; gap: 12px; }

  /* Step 2: single column — indicator → chip → name → dek → offering → form.
     v5: cream block on top (full-bleed), white form block below. */
  .bf-step2-cols {
    grid-template-columns: 1fr;
    gap: 0;
  }
  #bfStep2 .bf-step__inner { padding-bottom: 0; }
  .bf-step2-left { padding: 32px var(--gutter) 40px; min-height: 0; }
  .bf-chip { margin-bottom: 20px; }
  .bf-step2-dek { margin-top: 16px; }
  .bf-step2-offerings { margin-top: 28px; }
  .bf-offering { padding-top: 20px; }
  .bf-step2-formcol { margin-top: 0; padding: 40px var(--gutter) 56px; }
  .bf-step2-formcol > * { max-width: none; }

  /* Offering detail grid: 1-col on mobile, collapsed behind a toggle (no card bg) */
  .bf-offering-card { padding: 0; }
  .bf-offering-card__grid { gap: 0; }
  .bf-offering__toggle {
    display: flex;
    align-items: center;
    justify-content: space-between;
    width: 100%;
    background: none;
    border: none;
    padding: 0;
    cursor: pointer;
    font-family: var(--font-mono);
    font-size: 13px;
    letter-spacing: 0.110em;
    text-transform: uppercase;
    color: rgba(0,0,0,0.55);
    transition: color 0.2s ease;
  }
  .bf-offering__toggle:hover { color: var(--blue); }
  .bf-offering__toggle-icon { font-family: var(--font-body); font-size: 22px; line-height: 1; }
  .bf-offering-card__grid {
    grid-template-columns: 1fr;
    max-height: 0;
    overflow: hidden;
    opacity: 0;
    transition: max-height 0.4s cubic-bezier(0.16, 1, 0.3, 1), opacity 0.3s ease;
  }
  .bf-offering--expanded .bf-offering-card__grid {
    max-height: 1400px;
    opacity: 1;
    margin-top: 20px;
  }
  /* Stacked cells separated by hairlines (desktop uses the open 36×48 gap grid) */
  .bf-offering-card__section {
    padding: 16px 0;
    border-bottom: 0.5px solid rgba(0,0,0,0.10);
  }
  .bf-offering-card__section:last-child {
    border-bottom: none;
    padding-bottom: 0;
  }

  /* About heading */
  .bf-about-heading { font-size: 28px; margin-bottom: 4px; }

  /* Form fields */
  .bf-field { padding: 12px 0 14px; }
  .bf-label { margin-bottom: 4px; }

  #bfCalendlyMount { margin: 0 calc(-1 * var(--gutter)); }
}


</style>

<script is:inline>
(function () {

  var bfData = document.getElementById('bfData');
  var OPTION_LABELS = JSON.parse(bfData.dataset.labels);
  var CALENDLY_URLS = JSON.parse(bfData.dataset.urls);
  var OPTION_DEKS   = JSON.parse(bfData.dataset.deks);

  // ── State
  var selectedOption = null;

  // ── Elements
  var step1       = document.getElementById('bfStep1');
  var step2       = document.getElementById('bfStep2');
  var step3       = document.getElementById('bfStep3');
  var optionBtns  = document.querySelectorAll('.bf-option');
  var backBtn     = document.getElementById('bfBack');
  var step2Heading = document.getElementById('bfStep2Heading');
  var step2Dek     = document.getElementById('bfStep2Dek');
  var chipEl       = document.getElementById('bfChip');
  var aboutHeading = document.getElementById('bfAboutHeading');
  var formNote     = document.getElementById('bfFormNote');
  var reassureEl   = document.getElementById('bfReassure');
  var SUB_DEFAULT  = "A few details about you to get connected with a coach. You'll be scheduled for a free discovery fit-check, not a sales call.";
  var SUB_SELFLEAD = "A few details to get connected. Be the first to learn about the self-led practice, coming soon.";
  var REASSURE_DEFAULT  = 'No obligation. Your details are never shared.';
  var REASSURE_SELFLEAD = "We'll only email you about the self-led practice.";
  var optionInput = document.getElementById('bfOptionInput');
  var form        = document.getElementById('bfForm');
  var submitBtn   = document.getElementById('bfSubmit');

  var advanceTimer = null;

  // ── Step indicator — booking shows 3 steps, the Self-led waitlist shows 2.
  // Each step's container has a fixed "current" position; only the labels/count
  // change with the selected option.
  var STEPS_BOOKING  = ['Choose', 'Your details', 'Schedule'];
  var STEPS_WAITLIST = ['Choose', 'Join the list'];
  function renderSteps() {
    var labels = selectedOption === 'selflead' ? STEPS_WAITLIST : STEPS_BOOKING;
    [['bfSteps1', 1], ['bfSteps2', 2], ['bfSteps3', 3]].forEach(function (pair) {
      var el = document.getElementById(pair[0]);
      if (!el) return;
      var current = pair[1];
      var html = '';
      labels.forEach(function (label, i) {
        var n = i + 1;
        var cls = 'bf-step-item' + (n < current ? ' bf-step-item--done' : n === current ? ' bf-step-item--on' : '');
        var num = n < current ? '✓' : String(n);
        if (i) html += '<span class="bf-step-line"></span>';
        html += '<span class="' + cls + '"><span class="bf-step-item__num">' + num + '</span>' + label + '</span>';
      });
      el.innerHTML = html;
    });
  }
  renderSteps();

  // ── Read URL param on load
  var params = new URLSearchParams(window.location.search);
  var paramOption = params.get('option');
  if (paramOption && OPTION_LABELS[paramOption]) {
    selectOption(paramOption, true);
  }

  // Expose for hash-based deep links (homepage Begin drawer) — open + skip to Step 2
  window.__beginSelectOption = function (key) {
    if (OPTION_LABELS[key]) selectOption(key, true);
  };

  // ── Option selection
  optionBtns.forEach(function (btn) {
    btn.addEventListener('click', function () {
      selectOption(btn.dataset.key, false);
    });
  });

  function selectOption(key, immediate) {
    selectedOption = key;
    optionBtns.forEach(function (btn) {
      var pressed = btn.dataset.key === key;
      btn.setAttribute('aria-pressed', pressed ? 'true' : 'false');
    });
    clearTimeout(advanceTimer);
    advanceTimer = setTimeout(function () {
      var isWaitlist = selectedOption === 'selflead';
      var label = OPTION_LABELS[selectedOption] || '';

      step2Heading.textContent = label;
      if (step2Dek) step2Dek.textContent = OPTION_DEKS[selectedOption] || '';
      if (chipEl) {
        chipEl.textContent = isWaitlist ? 'Coming Winter 2026' : 'Selected · ' + label;
        chipEl.classList.toggle('bf-chip--soon', isWaitlist);
      }
      if (aboutHeading) aboutHeading.textContent = isWaitlist ? 'Join the waitlist' : 'About you';
      if (formNote) formNote.textContent = isWaitlist ? SUB_SELFLEAD : SUB_DEFAULT;
      if (reassureEl) reassureEl.textContent = isWaitlist ? REASSURE_SELFLEAD : REASSURE_DEFAULT;
      var submitLabel = document.getElementById('bfSubmitLabel');
      if (submitLabel) submitLabel.textContent = isWaitlist ? 'Notify me' : 'Continue to scheduling';
      if (form) form.classList.toggle('bf-form--waitlist', isWaitlist);
      renderSteps();
      optionInput.value = selectedOption;
      document.documentElement.classList.remove('bf-has-param');

      // Show/hide offering details; reset any open accordion on switch
      var allOfferings = ['bfOffering1on1','bfOfferingOrgs','bfOfferingGroup','bfOfferingSelflead'];
      var keyMap = { '1on1':'bfOffering1on1', 'orgs':'bfOfferingOrgs', 'group':'bfOfferingGroup', 'selflead':'bfOfferingSelflead' };
      allOfferings.forEach(function(id) {
        var el = document.getElementById(id);
        if (!el) return;
        var isActive = keyMap[selectedOption] === id;
        el.classList.toggle('bf-offering--hidden', !isActive);
        // Collapse sections when switching options
        if (!isActive) {
          el.classList.remove('bf-offering--expanded');
          var tog = el.querySelector('.bf-offering__toggle');
          if (tog) tog.setAttribute('aria-expanded', 'false');
          var icon = el.querySelector('.bf-offering__toggle-icon');
          if (icon) icon.textContent = '+';
        }
      });

      showStep(step2);
      window.scrollTo({ top: 0, behavior: 'smooth' });
    }, immediate ? 0 : 350);
  }

  // ── In-flow Back: Step 2 → Step 1, Step 3 → Step 2
  backBtn.addEventListener('click', function () {
    showStep(step1);
    window.scrollTo({ top: 0, behavior: 'smooth' });
  });
  var backBtn3 = document.getElementById('bfBack3');
  if (backBtn3) backBtn3.addEventListener('click', function () {
    showStep(step2);
    window.scrollTo({ top: 0, behavior: 'smooth' });
  });

  // ── Exit the flow (every × + the Step-1 Back link): close the drawer if we're
  // in it, otherwise let the <a href="/"> navigate home (standalone /begin page).
  function exitFlow(e) {
    var dr = document.getElementById('beginDrawer');
    if (dr && dr.classList.contains('open') && typeof window.__closeBeginDrawer === 'function') {
      e.preventDefault();
      window.__closeBeginDrawer();
    }
  }
  document.querySelectorAll('.bf-close, .bf-nav a.bf-back').forEach(function (el) {
    el.addEventListener('click', exitFlow);
  });

  // ── Offering accordion toggle
  document.querySelectorAll('.bf-offering__toggle').forEach(function(btn) {
    btn.addEventListener('click', function() {
      var offering = btn.closest('.bf-offering');
      var expanded = offering.classList.toggle('bf-offering--expanded');
      btn.setAttribute('aria-expanded', String(expanded));
      btn.querySelector('.bf-offering__toggle-icon').textContent = expanded ? '−' : '+';
    });
  });

  // ── Form submission
  var submitError = document.getElementById('bfSubmitError');
  submitBtn.addEventListener('click', async function () {
    if (!validateForm()) return;

    if (submitError) submitError.classList.remove('visible');
    submitBtn.disabled = true;
    submitBtn.classList.add('loading');

    var data = new URLSearchParams();
    data.append('form-name', 'begin');
    data.append('first-name', document.getElementById('bfFirstName').value.trim());
    data.append('email',      document.getElementById('bfEmail').value.trim());
    data.append('phone',      document.getElementById('bfPhone').value.trim());
    data.append('option',     selectedOption);

    // Confirm Netlify accepted the submission before advancing — don't silently lose the lead
    var ok = false;
    try {
      var res = await fetch('/', {
        method: 'POST',
        headers: { 'Content-Type': 'application/x-www-form-urlencoded' },
        body: data.toString(),
      });
      ok = res.ok;
    } catch (e) { ok = false; }

    if (ok) {
      // GA4 lead conversion — fires only on a confirmed Netlify submit
      if (window.gtag) window.gtag('event', 'generate_lead', { form_name: 'begin', option: selectedOption });
      advanceToStep3();
    } else {
      submitBtn.disabled = false;
      submitBtn.classList.remove('loading');
      if (submitError) submitError.classList.add('visible');
    }
  });

  function validateForm() {
    var valid = true;

    var firstName = document.getElementById('bfFirstName');
    var firstNameErr = document.getElementById('bfFirstNameError');
    if (!firstName.value.trim()) {
      firstName.classList.add('bf-input--error');
      firstNameErr.classList.add('visible');
      valid = false;
    } else {
      firstName.classList.remove('bf-input--error');
      firstNameErr.classList.remove('visible');
    }

    var email = document.getElementById('bfEmail');
    var emailErr = document.getElementById('bfEmailError');
    var emailOk = /^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(email.value.trim());
    if (!emailOk) {
      email.classList.add('bf-input--error');
      emailErr.classList.add('visible');
      valid = false;
    } else {
      email.classList.remove('bf-input--error');
      emailErr.classList.remove('visible');
    }

    return valid;
  }

  function advanceToStep3() {
    var calendlyMount  = document.getElementById('bfCalendlyMount');
    var calendlyWrap   = document.getElementById('bfCalendlyWrap');
    var selfleadWrap   = document.getElementById('bfSelfleadWrap');
    var calendlyEyebrow = document.getElementById('bfCalendlyEyebrow');

    if (selectedOption === 'selflead') {
      calendlyWrap.classList.add('bf-step--hidden');
      selfleadWrap.classList.remove('bf-step--hidden');
    } else {
      var url = CALENDLY_URLS[selectedOption];
      if (url && calendlyMount) {
        var primaryColor = '2956e0';
        var fullUrl = url + '?hide_gdpr_banner=1&primary_color=' + primaryColor + '&text_color=000000&background_color=ffffff';
        var widget = document.createElement('div');
        widget.className = 'calendly-inline-widget';
        widget.setAttribute('data-url', fullUrl);
        widget.style.minWidth = '280px';
        widget.style.height   = '700px';
        calendlyMount.appendChild(widget);

        if (typeof Calendly === 'undefined') {
          var s = document.createElement('script');
          s.src = 'https://assets.calendly.com/assets/external/widget.js';
          s.async = true;
          document.head.appendChild(s);
        } else {
          Calendly.initInlineWidgets();
        }
      }
      if (calendlyEyebrow) {
        calendlyEyebrow.textContent = OPTION_LABELS[selectedOption] || '';
      }
      selfleadWrap.classList.add('bf-step--hidden');
      calendlyWrap.classList.remove('bf-step--hidden');
    }

    showStep(step3);
    window.scrollTo({ top: 0, behavior: 'smooth' });
  }

  function showStep(target) {
    // Always clear bf-has-param so its high-specificity display rules can't interfere
    document.documentElement.classList.remove('bf-has-param');

    [step1, step2, step3].forEach(function (s) {
      if (s === target) {
        s.classList.remove('bf-step--hidden');
        s.style.removeProperty('display');
        // Re-trigger animation
        s.style.animation = 'none';
        s.offsetHeight; // reflow
        s.style.animation = '';
      } else {
        s.classList.add('bf-step--hidden');
        // Inline !important overrides any stylesheet rule including bf-has-param
        s.style.setProperty('display', 'none', 'important');
      }
    });
  }

  // ── Clear validation on input
  ['bfFirstName', 'bfEmail'].forEach(function (id) {
    var el = document.getElementById(id);
    if (el) {
      el.addEventListener('input', function () {
        el.classList.remove('bf-input--error');
        var errEl = document.getElementById(id + 'Error');
        if (errEl) errEl.classList.remove('visible');
      });
    }
  });

})();
</script>
