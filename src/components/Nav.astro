<nav class="nav" id="nav">
  {/* v5 — stacked wordmark SVG (Figma: 229.69×82 @1440, centered) */}
  <a href="/" class="nav__wordmark nav__wordmark--v5" aria-label="Every Day Future — home">
    <img src="/images/wordmark-stacked.svg" alt="Every Day Future" width="160" height="57" />
  </a>
  <div class="nav__right">
    {/* Writing link hidden 2026-06-22 — section kept live + indexed; reintroduce when more essays publish:
        <a href="/writing" class="nav__link nav__link--writing">Writing</a> */}
    <a href="https://portal.everydayfuture.work" class="nav__link nav__link--boxed" target="_blank" rel="noopener">Client Portal ↗</a>
  </div>
  <button class="nav__link mmenu-trigger" id="mmenuTrigger" aria-expanded="false" aria-controls="mmenu" aria-haspopup="dialog" aria-label="Menu">
    <svg width="26" height="16" viewBox="0 0 26 16" aria-hidden="true"><path d="M1 1.5h24M1 8h24" stroke="currentColor" stroke-width="1.4"/></svg>
  </button>
</nav>

<!-- Mobile menu curtain — sibling of .nav (a fixed child would be trapped by the
     scrolled nav's backdrop-filter containing block). Mobile-only (≤640px). -->
<div class="mmenu" id="mmenu" role="dialog" aria-modal="true" aria-label="Menu" aria-hidden="true">
  <div class="mmenu__nav">
    <img class="mmenu__wordmark" src="/images/wordmark-stacked.svg" alt="Every Day Future" />
    <button class="mmenu__close" id="mmenuClose" aria-label="Close menu">
      <svg width="22" height="22" viewBox="0 0 22 22" aria-hidden="true"><path d="M3 3l16 16M19 3L3 19" stroke="currentColor" stroke-width="1.4"/></svg>
    </button>
  </div>
  <div class="mmenu__links">
    <a class="mmenu__link" href="/" data-mkey="home">Home <span class="mmenu__num">01</span></a>
    {/* Writing link hidden 2026-06-22 — section kept live + indexed. To reintroduce: un-comment below
        (numeral 02) and renumber Contact → 03 and Client Portal → 04.
        <a class="mmenu__link" href="/writing" data-mkey="writing">Writing <span class="mmenu__num">02</span></a> */}
    <a class="mmenu__link" href="/contact" data-mkey="contact">Contact <span class="mmenu__num">02</span></a>
    <a class="mmenu__link" href="https://portal.everydayfuture.work" target="_blank" rel="noopener">Client Portal <span class="mmenu__num">03</span></a>
  </div>
  <a class="mmenu__cta" href="/begin" id="mmenuBegin">Begin Practice</a>
  <div class="mmenu__foot">
    <a href="https://instagram.com/everydayfuture" target="_blank" rel="noopener">Instagram</a>
    <a href="/terms">Terms</a>
    <a href="/privacy">Privacy</a>
  </div>
</div>

<style is:global>
/* ════════ MOBILE MENU (mmenu) — mobile-only (≤640px), see design.md §5.15 ════════
   The trigger reuses .nav__link (hero white / scrolled+page-* ink / text-shadow)
   so it tracks every existing nav color state with no new color logic. */
.mmenu-trigger { display: none; }
.mmenu { display: none; }

@media (max-width: 640px) {
  .mmenu-trigger {
    display: block;
    position: absolute;
    right: var(--gutter);
    background: none;
    border: none;
    cursor: pointer;
    padding: 6px 0;
    font-weight: 300;
  }
  .mmenu-trigger:active { color: var(--blue); }

  /* ── The curtain — Mobile Menu V3 comp (393x852): light gradient ground */
  .mmenu {
    display: flex;
    flex-direction: column;
    position: fixed;
    inset: 0;
    z-index: 500;
    background: linear-gradient(180deg, #FBFEF9 0%, #F4F9F0 100%);
    color: var(--ink);
    overflow-y: auto;
    -webkit-overflow-scrolling: touch;
    transform: translateY(-101%);
    transition: transform 0.45s cubic-bezier(0.16, 1, 0.3, 1);
    visibility: hidden;
    transition-property: transform, visibility;
  }
  .mmenu.open { transform: translateY(0); visibility: visible; }
  .mmenu:not(.open) { transition-delay: 0s, 0.45s; }

  /* ── Top row: stacked wordmark left, thin x right (comp: 64px bar, 20px sides) */
  /* wordmark identical to the closed-state homepage nav (centered, 112px,
     top 18) so it does not move or resize when the menu opens (Ben 2026-08-10) */
  .mmenu__nav {
    position: relative;
    display: flex;
    align-items: center;
    justify-content: flex-end;
    padding: 14px 20px 0;
    min-height: 64px;
  }
  .mmenu__wordmark {
    position: absolute;
    left: 50%;
    top: 18px;
    transform: translateX(-50%);
    width: 112px;
    height: auto;
  }
  .mmenu__close {
    background: none;
    border: none;
    cursor: pointer;
    padding: 6px;
    color: var(--ink);
    line-height: 0;
    transition: color 0.2s;
  }
  .mmenu__close:active { color: var(--blue); }

  /* ── Links: hairline rows, 52px labels, mono numerals right (comp: top 150) */
  .mmenu__links {
    flex: 1 0 auto;
    display: flex;
    flex-direction: column;
    justify-content: flex-start;
    margin-top: 86px;
    padding: 0 20px;
  }
  .mmenu__link {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 30px 2px;
    border-top: 1px solid rgba(0,0,0,0.25);
    font-family: var(--font-body);
    font-weight: 400;
    font-size: 52px;
    letter-spacing: -0.015em;
    line-height: 1;
    color: var(--ink);
    opacity: 0;
    transform: translateY(12px);
    transition: opacity 0.35s cubic-bezier(0.16,1,0.3,1), transform 0.35s cubic-bezier(0.16,1,0.3,1), color 0.15s ease;
  }
  .mmenu__link:last-of-type { border-bottom: 1px solid rgba(0,0,0,0.25); }
  .mmenu__num {
    font-family: var(--font-mono);
    font-weight: 400;
    font-size: 12px;
    letter-spacing: 0.14em;
    color: #6A6F66;
    transition: color 0.15s ease;
  }
  .mmenu__link:active,
  .mmenu__link:active .mmenu__num { color: var(--blue); }
  .mmenu__link--here .mmenu__num { color: var(--blue); }

  /* ── Begin Practice — black pill, hover/press blue (comp: 52px, bottom 118) */
  .mmenu__cta {
    margin: 24px 20px 42px;
    flex-shrink: 0;
    height: 52px;
    display: flex;
    align-items: center;
    justify-content: center;
    background: #0D0D0D;
    color: #fff;
    border-radius: 999px;
    font-family: var(--font-mono);
    font-weight: 300;
    font-size: 12px;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    opacity: 0;
    transform: translateY(12px);
    transition: opacity 0.35s cubic-bezier(0.16,1,0.3,1), transform 0.35s cubic-bezier(0.16,1,0.3,1), background 0.4s cubic-bezier(0.4,0,0.2,1);
  }
  .mmenu__cta:active { background: var(--blue); color: #fff; }

  /* ── Foot: full-bleed black bar (comp: 76px) */
  .mmenu__foot {
    flex-shrink: 0;
    display: flex;
    gap: 28px;
    align-items: center;
    justify-content: center;
    min-height: 76px;
    background: #000;
    padding: 0 20px calc(env(safe-area-inset-bottom, 0px));
    opacity: 0;
    transform: translateY(10px);
    transition: opacity 0.35s cubic-bezier(0.16,1,0.3,1), transform 0.35s cubic-bezier(0.16,1,0.3,1);
  }
  .mmenu__foot a {
    font-family: var(--font-mono);
    font-weight: 300;
    font-size: 10px;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: #E6E6DA;
  }
  .mmenu__foot a:active { color: #fff; }

  /* ── Stagger in as the curtain lands */
  .mmenu.open .mmenu__link,
  .mmenu.open .mmenu__cta,
  .mmenu.open .mmenu__foot { opacity: 1; transform: translateY(0); }
  .mmenu.open .mmenu__link:nth-of-type(1) { transition-delay: 0.15s, 0.15s, 0s; }
  .mmenu.open .mmenu__link:nth-of-type(2) { transition-delay: 0.21s, 0.21s, 0s; }
  .mmenu.open .mmenu__link:nth-of-type(3) { transition-delay: 0.27s, 0.27s, 0s; }
  .mmenu.open .mmenu__cta  { transition-delay: 0.34s, 0.34s, 0s; }
  .mmenu.open .mmenu__foot { transition-delay: 0.40s, 0.40s; }
  .mmenu:not(.open) .mmenu__link,
  .mmenu:not(.open) .mmenu__cta,
  .mmenu:not(.open) .mmenu__foot { transition-delay: 0s; transition-duration: 0.15s; }

  @media (prefers-reduced-motion: reduce) {
    .mmenu {
      transform: none;
      opacity: 0;
      transition: opacity 0.2s ease, visibility 0s 0.2s;
    }
    .mmenu.open { opacity: 1; transition-delay: 0s; }
    .mmenu__link, .mmenu__cta, .mmenu__foot { transform: none; transition-delay: 0s !important; }
  }
}
</style>

<script is:inline>
(function () {
  var menu    = document.getElementById('mmenu');
  var trigger = document.getElementById('mmenuTrigger');
  var closeBtn = document.getElementById('mmenuClose');
  var beginCta = document.getElementById('mmenuBegin');
  if (!menu || !trigger || !closeBtn) return;

  var lastFocus = null;

  function setOpen(open) {
    menu.classList.toggle('open', open);
    menu.setAttribute('aria-hidden', String(!open));
    trigger.setAttribute('aria-expanded', String(open));
    document.body.style.overflow = open ? 'hidden' : '';
    /* Exactly one Begin affordance while the menu is open.
       Looked up per-call: this script runs before CTABar renders. */
    var floatCta = document.getElementById('floatCta');
    if (floatCta) {
      floatCta.style.opacity = open ? '0' : '';
      floatCta.style.pointerEvents = open ? 'none' : '';
    }
    if (open) {
      lastFocus = document.activeElement;
      var first = menu.querySelector('.mmenu__link');
      if (first) setTimeout(function () { first.focus(); }, 480);
    } else if (lastFocus && typeof lastFocus.focus === 'function') {
      lastFocus.focus();
    }
  }

  trigger.addEventListener('click', function () { setOpen(true); });
  closeBtn.addEventListener('click', function () { setOpen(false); });

  /* If the viewport leaves mobile while open (e.g. phone rotates to landscape),
     the curtain display:none's away but the body scroll lock would persist — close. */
  var mq = window.matchMedia('(min-width: 641px)');
  var onMq = function (e) { if (e.matches && menu.classList.contains('open')) setOpen(false); };
  if (mq.addEventListener) mq.addEventListener('change', onMq);
  else if (mq.addListener) mq.addListener(onMq);

  document.addEventListener('keydown', function (e) {
    if (!menu.classList.contains('open')) return;
    if (e.key === 'Escape') { setOpen(false); return; }
    /* Focus trap */
    if (e.key === 'Tab') {
      var items = menu.querySelectorAll('a, button');
      if (!items.length) return;
      var first = items[0], last = items[items.length - 1];
      if (e.shiftKey && document.activeElement === first) { e.preventDefault(); last.focus(); }
      else if (!e.shiftKey && document.activeElement === last) { e.preventDefault(); first.focus(); }
    }
  });

  /* On the homepage, Begin Practice opens the Begin drawer (matching the float
     CTA); elsewhere the <a href="/begin"> navigates. Close-then-open keeps the
     body scroll lock correct (close clears it, the drawer re-locks). */
  if (beginCta) {
    beginCta.addEventListener('click', function (e) {
      if (typeof window.__openBeginDrawer === 'function') {
        e.preventDefault();
        setOpen(false);
        window.__openBeginDrawer();
      }
    });
  }

  /* Current page → blue numeral */
  var path = location.pathname;
  var key = path === '/' ? 'home'
    : path.indexOf('/writing') === 0 ? 'writing'
    : path.indexOf('/contact') === 0 ? 'contact'
    : null;
  if (key) {
    var here = menu.querySelector('[data-mkey="' + key + '"]');
    if (here) here.classList.add('mmenu__link--here');
  }
})();
</script>
