---
import Layout from '../layouts/Layout.astro';
import Nav from '../components/Nav.astro';
import Contact from '../components/Contact.astro';
import Footer from '../components/Footer.astro';
---

<Layout
  title="Contact Taylor Winters — Every Day Future"
  description="Get in touch with Taylor Winters at Every Day Future — conscious executive coaching for leaders and founders. Questions, ideas, or to explore working together."
>
  <Nav />

  <main class="page-contact-main">
    <Contact />
  </main>

  <Footer />
</Layout>

<script is:inline>
  document.documentElement.classList.add('page-contact');
</script>
