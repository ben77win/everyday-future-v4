---
import Layout from '../layouts/Layout.astro';
import Nav from '../components/Nav.astro';
import BeginFlow from '../components/BeginFlow.astro';
import Footer from '../components/Footer.astro';
---

<Layout
  title="Begin Your Practice — Every Day Future"
  description="Start your practice with Every Day Future. Choose 1:1, group, team, or self-led coaching and book a first conversation with Taylor Winters."
>
  <Nav />

  <main class="begin-page">
    <BeginFlow />
  </main>

  <Footer />
</Layout>

<style is:global>
  .page-begin .nav__wordmark,
  .page-begin .nav__link {
    color: var(--ink);
    text-shadow: none;
  }
  .page-begin .site-footer { display: none; }
  /* v5 (per Ben 2026-08-05): no Client Portal link inside the begin flow —
     it stays on the homepage nav only */
  .page-begin .nav__right { display: none; }

  /* Hide step 1 before paint when a valid option param is present */
  html.bf-has-param #bfStep1 { display: none !important; }
  html.bf-has-param #bfStep2 { display: flex !important; }
</style>

<style>
/* v5: no top padding — the step-2 cream/white split runs to the very top of
   the viewport, under the transparent fixed nav (per the 1440w light comp).
   Steps 1 & 3 get their own nav clearance below. */
.begin-page {
  padding-top: 0;
  background: var(--paper-off-b);
  min-height: 100vh;
}
.begin-page :global(#bfStep1 .bf-step__inner),
.begin-page :global(#bfStep3 .bf-step__inner) {
  padding-top: 150px;
}

@media (max-width: 640px) {
  .begin-page :global(#bfStep1 .bf-step__inner),
  .begin-page :global(#bfStep3 .bf-step__inner) {
    padding-top: 110px;
  }
}
</style>

<script is:inline>
  document.documentElement.classList.add('page-begin');
  (function() {
    var opt = new URLSearchParams(window.location.search).get('option');
    if (opt && ['1on1','group','orgs','selflead'].indexOf(opt) !== -1) {
      document.documentElement.classList.add('bf-has-param');
    }
  })();
</script>
