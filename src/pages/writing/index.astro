---
// /writing — the Writing index (handoff 6 spec, 2026-06-11). Pixel source:
// comps/Writing-Index-and-Article-Comp.html (screen A).
// Drafts are visible in the DEV PREVIEW ONLY — production builds exclude
// them, so this page ships empty until the first real essay is published.
import { getCollection } from 'astro:content';
import { Image } from 'astro:assets';
import Layout from '../../layouts/Layout.astro';
import Nav from '../../components/Nav.astro';
import Footer from '../../components/Footer.astro';

const entries = (
  await getCollection('writing', ({ data }) => import.meta.env.DEV || !data.draft)
).sort((a, b) => b.data.publishDate.valueOf() - a.data.publishDate.valueOf());

const featured = entries.find((entry) => entry.data.featured);
const rows = entries.filter((entry) => entry !== featured);
const categories = ['The Practice', 'Leadership', 'Change', 'Research', 'Field notes'];

const featuredDate = (date: Date) =>
  date.toLocaleDateString('en-US', { year: 'numeric', month: 'short', timeZone: 'UTC' });

const site = Astro.site ?? new URL('https://everydayfuture.work');
const collectionSchema = {
  '@context': 'https://schema.org',
  '@type': 'CollectionPage',
  name: 'Writing — Every Day Future',
  description:
    'Essays on conscious change, leadership, and the practice of working with what comes.',
  url: new URL('/writing/', site).href,
  isPartOf: { '@type': 'WebSite', name: 'Every Day Future', url: site.href },
};
---
<Layout
  title="Writing — Every Day Future"
  description="Essays on conscious change, leadership, and the practice of working with what comes — from Every Day Future, a conscious executive coaching practice."
>
  <Nav />

  <main class="wx">
    <div class="wx__head">
      <div class="wx__eyebrow">Writing</div>
      <h1 class="wx__title">Notes on practice</h1>
      <p class="wx__lead">Essays on conscious change, leadership, and the practice of working with what comes — not against it.</p>
    </div>

    <div class="wx__topics" id="wxTopics">
      <button class="wx__topic wx__topic--on" data-topic="all">All</button>
      {categories.map((category) => (
        <button class="wx__topic" data-topic={category}>{category}</button>
      ))}
    </div>

    {featured && (
      <article class="wx__feature" data-category={featured.data.category}>
        <a class="wx__feature-media" href={`/writing/${featured.slug}/`}>
          {featured.data.heroImage && <Image src={featured.data.heroImage} alt={featured.data.heroAlt ?? ''} widths={[480, 800, 1320]} sizes="(max-width: 900px) 100vw, 660px" loading="eager" />}
        </a>
        <div>
          <div class="wx__feature-meta">
            {featured.data.category} <span class="dot">·</span> {featuredDate(featured.data.publishDate)} <span class="dot">·</span> {featured.data.readingTime.replace(' read', '')}
          </div>
          <h2 class="wx__feature-title"><a href={`/writing/${featured.slug}/`}>{featured.data.title}</a></h2>
          <p class="wx__feature-dek">{featured.data.dek}</p>
          <a class="wx__readmore" href={`/writing/${featured.slug}/`}>
            Read the essay
            <svg width="28" height="12" viewBox="0 0 28 12" fill="none" stroke="currentColor" stroke-width="1"><path d="M0 6h26M21 1l5 5-5 5" /></svg>
          </a>
        </div>
      </article>
    )}

    <div class="wx__list">
      {rows.map((entry) => (
        <a class="wx__row" href={`/writing/${entry.slug}/`} data-category={entry.data.category}>
          <div class="wx__row-meta">
            <span class="wx__row-cat">{entry.data.category}</span>
            {featuredDate(entry.data.publishDate)}
          </div>
          <div>
            <div class="wx__row-title">{entry.data.title}</div>
            <p class="wx__row-dek">{entry.data.dek}</p>
          </div>
          <div class="wx__row-read">{entry.data.readingTime}</div>
        </a>
      ))}
      {entries.length === 0 && <p class="wx__empty">Essays are on the way.</p>}
    </div>
  </main>

  <Footer />
</Layout>

<script type="application/ld+json" set:html={JSON.stringify(collectionSchema)} />

<script is:inline>
  document.documentElement.classList.add('page-writing');
  // No hero on this page, so the homepage observer never fires — reuse the
  // existing .nav.scrolled glass state once the reader scrolls.
  (function () {
    var nav = document.getElementById('nav');
    if (!nav) return;
    var onScroll = function () { nav.classList.toggle('scrolled', window.scrollY > 8); };
    onScroll();
    window.addEventListener('scroll', onScroll, { passive: true });
  })();
</script>

<script>
  // Topic filter — client-side show/hide on data-category
  const topics = document.querySelectorAll('.wx__topic');
  const items = document.querySelectorAll('[data-category]');
  topics.forEach((btn) => {
    btn.addEventListener('click', () => {
      topics.forEach((other) => other.classList.toggle('wx__topic--on', other === btn));
      const topic = btn.getAttribute('data-topic');
      items.forEach((item) => {
        (item as HTMLElement).style.display =
          topic === 'all' || item.getAttribute('data-category') === topic ? '' : 'none';
      });
    });
  });
</script>

<style is:global>
  /* ════ Writing — index (wx prefix, scoped by convention) ════
     0.5px hairlines + 11/12px mono are Writing-only departures (Ben 2026-06-11). */
  .wx { background: var(--paper); }
  .wx__head { max-width: var(--max-w); margin: 0 auto; padding: 120px var(--gutter) 56px; }
  .wx__eyebrow { font-family: var(--font-mono); font-size: 13px; letter-spacing: 0.110em; text-transform: uppercase; color: rgba(0,0,0,0.4); margin-bottom: 28px; }
  .wx__title { font-family: var(--font-body); font-weight: 400; font-size: clamp(46px, 5.6vw, 84px); line-height: 1; letter-spacing: -0.030em; color: var(--ink); }
  .wx__lead { font-family: var(--font-body); font-weight: 400; font-size: clamp(22px, 2.2vw, 32px); line-height: 1.2; letter-spacing: -0.010em; color: var(--ink); max-width: 760px; margin-top: 32px; }

  .wx__topics { max-width: var(--max-w); margin: 0 auto; padding: 0 var(--gutter) 48px; display: flex; gap: 10px; flex-wrap: wrap; border-bottom: 0.5px solid rgba(0,0,0,0.14); }
  .wx__topic { font-family: var(--font-mono); font-size: 12px; letter-spacing: 0.110em; text-transform: uppercase; color: rgba(0,0,0,0.55); padding: 8px 16px; border: 0.5px solid rgba(0,0,0,0.25); border-radius: 4px; background: transparent; cursor: pointer; transition: border-color 0.2s, color 0.2s, background 0.2s; }
  .wx__topic:hover { border-color: var(--blue); color: var(--blue); }
  .wx__topic--on { background: var(--ink); border-color: var(--ink); color: #fff; }
  .wx__topic--on:hover { border-color: var(--ink); color: #fff; }

  .wx__feature { max-width: var(--max-w); margin: 0 auto; padding: 64px var(--gutter); display: grid; grid-template-columns: 1.15fr 1fr; gap: 64px; align-items: center; border-bottom: 0.5px solid rgba(0,0,0,0.14); }
  .wx__feature-media { aspect-ratio: 4/3; overflow: hidden; display: block; }
  .wx__feature-media img { width: 100%; height: 100%; object-fit: cover; }
  .wx__feature-meta { font-family: var(--font-mono); font-size: 12px; letter-spacing: 0.110em; text-transform: uppercase; color: var(--blue); margin-bottom: 24px; display: flex; gap: 14px; }
  .wx__feature-meta .dot { color: rgba(0,0,0,0.3); }
  .wx__feature-title { font-family: var(--font-body); font-weight: 400; font-size: clamp(32px, 3.4vw, 46px); line-height: 1.05; letter-spacing: -0.025em; color: var(--ink); margin-bottom: 20px; }
  .wx__feature-dek { font-family: var(--font-body); font-weight: 300; font-size: 17px; line-height: 24px; letter-spacing: 0.020em; color: rgba(0,0,0,0.6); max-width: 460px; margin-bottom: 28px; }
  .wx__readmore { font-family: var(--font-mono); font-size: 13px; letter-spacing: 0.110em; text-transform: uppercase; color: var(--ink); display: inline-flex; align-items: center; gap: 10px; transition: color 0.2s; }
  .wx__readmore svg { transition: transform 0.25s; }
  .wx__readmore:hover { color: var(--blue); }
  .wx__readmore:hover svg { transform: translateX(6px); }

  .wx__list { max-width: var(--max-w); margin: 0 auto; padding: 0 var(--gutter) 120px; }
  .wx__row { display: grid; grid-template-columns: 160px 1fr 200px; gap: 48px; align-items: baseline; padding: 40px 0; border-bottom: 0.5px solid rgba(0,0,0,0.14); cursor: pointer; transition: padding 0.2s; }
  .wx__row:hover { padding-left: 8px; }
  .wx__row-meta { font-family: var(--font-mono); font-size: 12px; letter-spacing: 0.10em; text-transform: uppercase; color: rgba(0,0,0,0.45); line-height: 1.7; }
  .wx__row-cat { color: var(--blue); display: block; margin-bottom: 4px; }
  .wx__row-title { font-family: var(--font-body); font-weight: 400; font-size: clamp(24px, 2.4vw, 32px); line-height: 1.1; letter-spacing: -0.020em; color: var(--ink); transition: color 0.2s; }
  .wx__row:hover .wx__row-title { color: var(--blue); }
  .wx__row-dek { font-family: var(--font-body); font-weight: 300; font-size: 15px; line-height: 22px; letter-spacing: 0.020em; color: rgba(0,0,0,0.55); margin-top: 10px; max-width: 560px; }
  .wx__row-read { font-family: var(--font-mono); font-size: 12px; letter-spacing: 0.10em; text-transform: uppercase; color: rgba(0,0,0,0.4); text-align: right; }
  .wx__empty { font-family: var(--font-body); font-weight: 300; font-size: 17px; color: rgba(0,0,0,0.55); padding: 64px 0; }

  @media (max-width: 900px) {
    .wx__feature { grid-template-columns: 1fr; gap: 32px; }
    .wx__row { grid-template-columns: 1fr; gap: 12px; }
    .wx__row-read { text-align: left; }
  }
</style>
