---
import Layout from '../layouts/Layout.astro';
import Nav from '../components/Nav.astro';
import Hero from '../components/Hero.astro';
import CTABar from '../components/CTABar.astro';
import Services from '../components/Services.astro';
import Process from '../components/Process.astro';
import Testimonials from '../components/Testimonials.astro';
import About from '../components/About.astro';
import Waymaker from '../components/Waymaker.astro';
import TaylorBio from '../components/TaylorBio.astro';
import FAQ from '../components/FAQ.astro';
import Footer from '../components/Footer.astro';
import BeginFlow from '../components/BeginFlow.astro';
import LoadScreen from '../components/LoadScreen.astro';

// Organization + Person structured data (entity / AI citation). Facts traceable to site copy.
const orgPersonLd = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "ProfessionalService",
      "@id": "https://everydayfuture.work/#business",
      "name": "Every Day Future",
      "legalName": "LTW Coaching LLC",
      "url": "https://everydayfuture.work",
      "image": "https://everydayfuture.work/images/og-image.png",
      "description": "Conscious executive coaching for leaders and founders navigating change.",
      "founder": { "@id": "https://everydayfuture.work/#taylor" },
      "areaServed": ["United States", "Europe"],
      "address": {
        "@type": "PostalAddress",
        "addressLocality": "Seattle",
        "addressRegion": "WA",
        "addressCountry": "US",
      },
      "email": "coach@everydayfuture.work",
      "sameAs": [
        "https://www.linkedin.com/in/ltaylorwinters/",
        "https://instagram.com/everydayfuture",
      ],
    },
    {
      "@type": "Person",
      "@id": "https://everydayfuture.work/#taylor",
      "name": "Taylor Winters",
      "jobTitle": "Founder & Conscious Executive Coach",
      "worksFor": { "@id": "https://everydayfuture.work/#business" },
      "knowsAbout": [
        "Executive coaching",
        "Leadership coaching",
        "Conscious change",
        "Mindfulness",
        "Interpersonal Neurobiology",
      ],
      "hasCredential": "Executive Coaching Certification — UC Berkeley Haas School of Business",
      "sameAs": [
        "https://www.linkedin.com/in/ltaylorwinters/",
        "https://instagram.com/everydayfuture",
      ],
    },
  ],
};
---
<Layout
  title="Conscious Executive Coaching — Every Day Future"
  description="Conscious executive coaching with Taylor Winters — for leaders and founders navigating change. Reduce resistance, expand possibility. Seattle-based, remote."
>
  <script type="application/ld+json" set:html={JSON.stringify(orgPersonLd)} is:inline />
  <LoadScreen />
  <Nav />
  <Hero />
  <CTABar />
  <Services />
  <Process />
  <Testimonials />
  <About />
  <Waymaker />
  <TaylorBio />
  <FAQ />
  <Footer />

  <!-- ── Begin drawer ── -->
  <div class="begin-drawer" id="beginDrawer" role="dialog" aria-modal="true" aria-label="Begin your practice" aria-hidden="true">
    <main class="begin-page begin-page--drawer">
      <BeginFlow />
    </main>
  </div>
  <div class="begin-drawer__scrim" id="beginDrawerScrim"></div>
</Layout>

<style is:global>
  /* Hide step 1 before paint when a valid option param is present */
  html.bf-has-param #bfStep1 { display: none !important; }
  html.bf-has-param #bfStep2 { display: flex !important; }
</style>

<style>
/* ── Drawer shell */
.begin-drawer {
  position: fixed;
  inset: 0;
  z-index: 600;
  background: var(--paper-cream, #fffcd1);
  transform: translateY(100%);
  transition: transform 0.55s cubic-bezier(0.16, 1, 0.3, 1);
  display: flex;
  flex-direction: column;
  overflow: hidden;
}
.begin-drawer.open {
  transform: translateY(0);
}

/* (Drawer top bar removed — the flow's own sticky .bf-nav now provides Back/close.) */

/* ── Scrollable content */
.begin-page--drawer {
  flex: 1;
  overflow-y: auto;
  -webkit-overflow-scrolling: touch;
  padding-top: 0 !important;
  background: transparent;
  min-height: 0;
}

/* ── Scrim */
.begin-drawer__scrim {
  position: fixed;
  inset: 0;
  z-index: 599;
  background: rgba(0,0,0,0.35);
  opacity: 0;
  pointer-events: none;
  transition: opacity 0.4s ease;
}
.begin-drawer__scrim.visible {
  opacity: 1;
  pointer-events: auto;
}

</style>

<script is:inline>
(function () {
  var drawer     = document.getElementById('beginDrawer');
  var scrim      = document.getElementById('beginDrawerScrim');
  var scrollArea = drawer ? drawer.querySelector('.begin-page--drawer') : null;

  if (!drawer || !scrim || !scrollArea) return;

  var _origScrollTo = window.scrollTo.bind(window);

  function openDrawer() {
    drawer.classList.add('open');
    drawer.setAttribute('aria-hidden', 'false');
    scrim.classList.add('visible');
    document.body.style.overflow = 'hidden';
    history.pushState({ beginDrawer: true }, '', '/begin');

    // Patch window.scrollTo so BeginFlow's step transitions scroll the drawer
    window.scrollTo = function (opts) {
      if (opts && typeof opts === 'object' && opts.top === 0) {
        scrollArea.scrollTo({ top: 0, behavior: opts.behavior || 'smooth' });
      } else {
        _origScrollTo.apply(window, arguments);
      }
    };

    // Focus first interactive element
    var firstBtn = drawer.querySelector('button, input, a');
    if (firstBtn) setTimeout(function () { firstBtn.focus(); }, 550);
  }

  function closeDrawer() {
    drawer.classList.remove('open');
    drawer.setAttribute('aria-hidden', 'true');
    scrim.classList.remove('visible');
    document.body.style.overflow = '';
    window.scrollTo = _origScrollTo;
    if (location.pathname === '/begin') {
      history.replaceState(null, '', '/');
    }
  }

  window.__openBeginDrawer = openDrawer;
  window.__closeBeginDrawer = closeDrawer;   // BeginFlow's in-flow × / Step-1 Back call this to close the drawer

  scrim.addEventListener('click', closeDrawer);

  window.addEventListener('popstate', function (e) {
    if (drawer.classList.contains('open')) {
      closeDrawer();
    }
  });

  // Keyboard: Escape closes
  document.addEventListener('keydown', function (e) {
    if (e.key === 'Escape' && drawer.classList.contains('open')) {
      closeDrawer();
    }
  });
})();
</script>

<script is:inline>
/* Begin deep links: #1-1coaching / #orgcoaching / #groupcoaching / #selfcoaching
   open the homepage Begin drawer and skip to Step 2 with that option preselected.
   (Fragments only — no SEO/canonical impact; section anchors like #faq are native.) */
(function () {
  var BEGIN_SLUGS = {
    '1-1coaching':  '1on1',
    'orgcoaching':  'orgs',
    'groupcoaching':'group',
    'selfcoaching': 'selflead'
  };

  function handleHash() {
    var slug = (location.hash || '').replace(/^#/, '').toLowerCase();
    var key  = BEGIN_SLUGS[slug];
    if (!key) return;

    function go() {
      if (typeof window.__openBeginDrawer === 'function') window.__openBeginDrawer();
      if (typeof window.__beginSelectOption === 'function') window.__beginSelectOption(key);
    }
    if (window.__openBeginDrawer && window.__beginSelectOption) go();
    else window.addEventListener('load', go, { once: true });
  }

  if (document.readyState !== 'loading') handleHash();
  else document.addEventListener('DOMContentLoaded', handleHash);
  window.addEventListener('hashchange', handleHash);
})();
</script>
